    if (number%2==0)
        return true;
    else
    return false;
}

int main(){
    int number;
    cout<<"Enter the value of number : ";
    cin>>number;
    int result=isEven(number);
    // cout<<result;
    if(result==1)
    cout<<"even";
    else 
