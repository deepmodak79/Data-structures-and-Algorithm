//Write a function named addNumbers that:

//Accepts two integers
//Returns their sum
//Is called from main()
//Prints the returned result


#include <iostream>
using namespace std;

int addNumbers(int a, int b){
    int sum=a+b;
    return sum;
}


int main(){
    int a,b;
    cout<<"Enter the value of a : ";
    cin>>a;
    cout<<"Enter the value of b : ";
    cin>>b;
    int result=addNumbers(a,b);
    cout<<"Sum of value a and b : ";
    cout<<result;
    return 0;
}


