Return the first element of a vector

Write a function that takes a vector of integers and returns the first element.

You can assume the vector is not empty.

Example
Input: [10, 20, 30]
Output: 10



#include <bits/stdc++.h>
using namespace std;

int getvalue(const vector<int>& nums){
    return nums[0];
}

int main(){
    int n;
    cout<<"Enter number of value in the array : ";
    cin>>n;
    vector<int> nums(n);
    
    for (int i=0;i<n;i++){
        cout<<"Enter the value in the array : ";
        cin>>nums[i];
    }
    cout<<getvalue(nums);
    return 0;
}
