#include <bits/stdc++.h>
using namespace std;


int getLength(const string& s){
    return s.length();
}

int main(){
    string s;
    cout<<"Enter the value of s : ";
    getline(cin,s); // So we use this because to count space as well as if we only write cin>>s then it will stops after space or tab and if we write anyhting after it will not calculate that.
    //cin>>s;
    cout<<"The length of the value s is "<<getLength(s);
    return 0;
}
